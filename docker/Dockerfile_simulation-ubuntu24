#
# PX4 + ROS 2 Jazzy + Gazebo Harmonic development environment (Ubuntu 24.04).
#
# Everything uavros2 needs at the system level: PX4 SITL toolchain, Gazebo
# Harmonic, ros_gz, ros2_control + gz_ros2_control, MoveIt, Zenoh RMW, the
# Micro XRCE-DDS Agent and GeographicLib datasets. The ROS workspace itself
# (uavros2, the mavros fork, PX4-Autopilot) is NOT baked in: clone it into
# the shared volume and run uavros2's install.sh, or use Dockerfile_uavros2
# for a ready-to-run image.
#
#   make px4-dev-simulation-ubuntu24
#

FROM osrf/ros:jazzy-desktop
LABEL maintainer="Abdulrahman S. Al-Batati <asmalbatati@hotmail.com>"

ENV DEBIAN_FRONTEND=noninteractive

#
# Micro XRCE-DDS Agent (PX4 uXRCE-DDS bridge), pinned to the version PX4 documents
#
RUN git clone -b v2.4.3 --depth 1 https://github.com/eProsima/Micro-XRCE-DDS-Agent.git /tmp/xrce && \
    cd /tmp/xrce && mkdir build && cd build && \
    cmake .. && make -j"$(nproc)" && make install && ldconfig /usr/local/lib/ && \
    rm -rf /tmp/xrce

RUN apt-get update && apt-get -y --quiet --no-install-recommends install \
		bzip2 \
		ca-certificates \
		ccache \
		cmake \
		cppcheck \
		curl \
		dirmngr \
		doxygen \
		file \
		g++ \
		gcc \
		gdb \
		git \
		git-lfs \
		gnupg \
		gosu \
		lcov \
		libfreetype6-dev \
		libgtest-dev \
		libpng-dev \
		libssl-dev \
		lsb-release \
		make \
		openssh-client \
		pkg-config \
		python3-dev \
		python3-pip \
		rsync \
		shellcheck \
		tzdata \
		unzip \
		valgrind \
		wget \
		xsltproc \
		zip \
		gedit \
		bash-completion \
		command-not-found \
	&& apt-get -y autoremove \
	&& apt-get clean autoclean \
	&& rm -rf /var/lib/apt/lists/{apt,dpkg,cache,log} /tmp/* /var/tmp/*

COPY scripts/px4_dev.sh /tmp/px4_dev.sh
COPY scripts/requirements.txt /tmp/requirements.txt

#
# PX4 SITL requirements and Gazebo Harmonic (no NuttX cross toolchain: SITL only)
#
RUN chmod +x /tmp/px4_dev.sh && /tmp/px4_dev.sh --no-nuttx && rm -rf /var/lib/apt/lists/*

# create user with id 1000 (or use existing user if UID 1000 exists)
RUN if id 1000 >/dev/null 2>&1; then \
        # User with UID 1000 already exists, modify it \
        EXISTING_USER=$(id -nu 1000) && \
        usermod -l user -d /home/user -m $EXISTING_USER && \
        groupmod -n user $(id -gn 1000) 2>/dev/null || true; \
    else \
        # Create new user with UID 1000 \
        useradd --shell /bin/bash -u 1000 -c "" -m user; \
    fi && \
    usermod -a -G dialout user && \
    echo "user:user" | chpasswd && \
    adduser user sudo

# Some QT-Apps/Gazebo don't not show controls without this
ENV QT_X11_NO_MITSHM=1

# Use UTF8 encoding in java tools (needed to compile jMAVSim)
ENV JAVA_TOOL_OPTIONS=-Dfile.encoding=UTF8

# Install JSBSim
RUN wget -q https://github.com/JSBSim-Team/jsbsim/releases/download/v1.2.3/JSBSim-devel_1.2.3-1561.noble.amd64.deb && \
    dpkg -i JSBSim-devel_1.2.3-1561.noble.amd64.deb && rm JSBSim-devel_1.2.3-1561.noble.amd64.deb

#
# Install VS Code for easy code development
#
RUN wget -qO- https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > packages.microsoft.gpg && \
	install -D -o root -g root -m 644 packages.microsoft.gpg /etc/apt/keyrings/packages.microsoft.gpg && \
	sh -c 'echo "deb [arch=amd64,arm64,armhf signed-by=/etc/apt/keyrings/packages.microsoft.gpg] https://packages.microsoft.com/repos/code stable main" > /etc/apt/sources.list.d/vscode.list' && \
	rm -f packages.microsoft.gpg
RUN apt-get update && apt-get install -y apt-transport-https code && rm -rf /var/lib/apt/lists/*

#
# ROS 2 side of the simulation: ros_gz (binary, built for Harmonic on Jazzy),
# ros2_control + gz_ros2_control for the arms, MoveIt, Zenoh RMW, and the
# libraries the mavros fork builds against. uavros2's install.sh runs rosdep
# for anything else.
#
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-ros-gz \
    ros-jazzy-gz-ros2-control \
    ros-jazzy-ros2-control \
    ros-jazzy-ros2-controllers \
    ros-jazzy-moveit \
    ros-jazzy-xacro \
    ros-jazzy-rmw-zenoh-cpp \
    ros-jazzy-geographic-msgs \
    ros-jazzy-angles \
    ros-jazzy-tf2-eigen \
    ros-jazzy-yaml-cpp-vendor \
    ros-jazzy-eigen-stl-containers \
    libgeographiclib-dev \
    geographiclib-tools \
    python3-jinja2 \
    python3-pytest \
    && rm -rf /var/lib/apt/lists/*

# uavros2's asset descriptors need pydantic >= 2 (Ubuntu 24.04 ships 1.10)
RUN python3 -m pip install --break-system-packages --no-cache-dir "pydantic>=2" typer

# GeographicLib datasets for MAVROS (geoid, gravity and magnetic models)
RUN geographiclib-get-geoids egm96-5 && \
    geographiclib-get-gravity egm96 && \
    geographiclib-get-magnetic emm2015

USER user
WORKDIR /home/user
RUN rosdep update
RUN echo "source /opt/ros/jazzy/setup.bash" >> /home/user/.bashrc

USER root
# create and start as LOCAL_USER_ID
COPY scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

WORKDIR /home/user

CMD ["/bin/bash"]
